# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing / tooling caches
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Proofload run stores. The default store root is ./proofload-runs.
proofload-runs/

# Session notes: a symlink into the vault. No trailing slash, or the symlink gets through.
notes

# Agent tooling
.claude/

# Editors / OS
.vscode/
.idea/
.DS_Store

# The o200k_base encoding file. Not vendored: its redistribution terms could not be
# established (NOTICE). `python -m poisson_tasks.fetch_encoding` puts it here.
src/poisson_tasks/data/*.tiktoken

# The example sweep writes its registration, registry module and run store here.
examples/**/example-store/

# Devlogs live in the vault only (docs/repo-hygiene.md, section 2.7)
devlog.md

# Local secrets. Never committed, and the live smoke reads MODEL_API_KEY from here.
.env
.env.local
