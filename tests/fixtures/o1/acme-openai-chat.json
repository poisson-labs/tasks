      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "refund_order",
      "description": "Refund part or all of an order.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": "The order's id, six characters such as A-3317.",
            "minLength": 6,
            "maxLength": 6
          },
          "amount": {
            "type": "number",
            "description": "The amount to refund, in dollars.",
            "minimum": 0
          },
          "reason": {
            "type": "string",
